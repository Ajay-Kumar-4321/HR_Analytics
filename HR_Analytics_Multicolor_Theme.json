{
  "name": "HR Analytics Multicolor",
  "dataColors": [
    "#2E6B52",
    "#E07A5F",
    "#3D85C6",
    "#F2B134",
    "#8E6BBF",
    "#17A2A2",
    "#D1495B",
    "#7A8B99"
  ],
  "background": "#FFFFFF",
  "foreground": "#252423",
  "tableAccent": "#2E6B52",
  "good": "#2E8B57",
  "neutral": "#F2B134",
  "bad": "#D1495B",
  "maximum": "#2E6B52",
  "center": "#F2B134",
  "minimum": "#D1495B",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F3D33"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F3D33"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F3D33"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#4A5A54"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DDE3E0"
              }
            },
            "radius": 6
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#1F3D33"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F4"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "dataPoint": [
          {
            "showAllDataPoints": true
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 10
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "dataPoint": [
          {
            "showAllDataPoints": true
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 10
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "dataPoint": [
          {
            "showAllDataPoints": true
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 10
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "dataPoint": [
          {
            "showAllDataPoints": true
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 10
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Bottom"
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 10
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 26,
            "color": {
              "solid": {
                "color": "#1F3D33"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#4A5A54"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#1F3D33"
              }
            }
          }
        ]
      }
    }
  }
}